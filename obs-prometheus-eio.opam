# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Prometheus text-exposition backend for obs-eio"
description: """
Accumulates counter/gauge/histogram deltas in-process and renders them as Prometheus
text exposition format on demand, plus an optional Pushgateway client for short-lived
jobs. Not a general-purpose Prometheus client and not a replacement for prometheus or
prometheus-eio: it is the Prometheus backend for obs-eio's Obs.backend interface,
positioned for services that already use obs-eio for tracing and logging."""
maintainer: ["lbendtlynielsen@gmail.com"]
authors: ["lbendtly"]
license: "MIT"
homepage: "https://github.com/loganbnielsen/obs-prometheus-eio"
bug-reports: "https://github.com/loganbnielsen/obs-prometheus-eio/issues"
depends: [
  "ocaml" {>= "5.4.0"}
  "dune" {>= "3.0" & >= "3.0"}
  "obs-eio" {>= "0.1.0"}
  "eio" {>= "1.3"}
  "eio_main" {>= "1.3"}
  "cohttp-eio" {>= "6.2.0"}
  "uri" {>= "4.4.0"}
  "http" {>= "6.0.0"}
  "tls-eio" {>= "2.1.0"}
  "x509" {>= "1.0.0"}
  "domain-name" {>= "0.5.0"}
  "ptime" {>= "1.2.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/loganbnielsen/obs-prometheus-eio.git"
